# =========================
# ASP.NET Core local settings / secrets
# =========================
# Ignore appsettings by default
**/appsettings.json
**/appsettings.*.json
# Recommend committing examples instead of real secrets
!**/appsettings.Development.json.example
!**/appsettings.Production.json.example

# Env files
**/.env
**/.env.*
!**/.env.example

# User secrets (usually not in repo)
**/*secrets*.json

# =========================
# Logs
# =========================
*.log
logs/
**/logs/


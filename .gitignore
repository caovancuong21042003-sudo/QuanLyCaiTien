# =========================
# Lockfiles: pick one strategy
# =========================
# Usually COMMIT exactly one lockfile depending on your package manager.
# Uncomment the ones you DON'T use.

# If using npm:
# yarn.lock
# pnpm-lock.yaml

# If using yarn:
# package-lock.json
# pnpm-lock.yaml

# If using pnpm:
# package-lock.json
# yarn.lock
